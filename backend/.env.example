# Voice-RAG backend configuration template.
# Copy to .env and adjust. Every variable is optional — defaults match config.py.

# --- Retrieval / chunking -------------------------------------------------
# CHUNKING_STRATEGY=recursive
# VOICE_RAG_DATA_DIR=
# VOICE_RAG_MODEL_NAME=intfloat/multilingual-e5-small
# VOICE_RAG_DEFAULT_TOP_K=10
# VOICE_RAG_MAX_TOP_K=50
# VOICE_RAG_INDEXES_DIR= (default data/indexes; production loads <dir>/<strategy>, e.g. data/indexes/recursive)

# --- Speech-to-text (Segment 4A) ------------------------------------------
# STT_MODEL_SIZE=small
# STT_DEVICE=cpu
# STT_COMPUTE_TYPE=int8
# STT_MAX_UPLOAD_BYTES=26214400

# --- Input guardrail (Segment 4B) -----------------------------------------
# GR_MAX_INPUT_CHARS=2000

# --- LLM answer generation (Segment 4C) -----------------------------------
# Provider: ollama (default, local, no key) or openai.
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:3b
# Only needed for LLM_PROVIDER=openai — never commit a real key.
# LLM_API_KEY=
# LLM_BASE_URL=
# LLM_TIMEOUT_S=120
# LLM_TEMPERATURE=0.2
# LLM_MAX_TOKENS=300
# LLM_MAX_CONTEXT_CHARS=8000

# --- Text-to-speech (Segment 4D) -------------------------------------------
# Provider: edge (default) — Microsoft Edge neural voices via edge-tts.
# No API key; network access required. English + genuine Urdu (ur-PK-UzmaNeural).
TTS_PROVIDER=edge
TTS_VOICE_EN=en-US-AriaNeural
TTS_VOICE_UR=ur-PK-UzmaNeural
# TTS_RATE=+0%
# TTS_FORMAT=wav

# --- Voice UI / API (Segments 5 + 6) ----------------------------------------
# Upload formats accepted by the STT + voice endpoints.
# STT_ALLOWED_EXTENSIONS=.wav,.mp3,.m4a,.webm,.ogg
# Dev origins allowed by CORS (never use '*').
# VOICE_RAG_ALLOWED_ORIGINS=http://localhost:8001
# Directory served at /ui (default: <repo>/frontend).
# VOICE_RAG_FRONTEND_DIR=
